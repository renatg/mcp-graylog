# --- Один инстанс ---
GRAYLOG_URL=https://graylog.local:9000
GRAYLOG_TOKEN=your-graylog-api-token
# Или ссылка на другую переменную окружения, где лежит токен:
# GRAYLOG_TOKEN=${GRAYLOG_SECRET}

# --- Несколько инстансов (если задано, GRAYLOG_URL/GRAYLOG_TOKEN не используются) ---
# Первое имя в списке — инстанс по умолчанию.
# GRAYLOG_INSTANCES=prod,stage
# GRAYLOG_PROD_URL=https://graylog-prod.local:9000
# GRAYLOG_PROD_TOKEN=prod-token
# GRAYLOG_STAGE_URL=https://graylog-stage.local:9000
# GRAYLOG_STAGE_TOKEN=stage-token
# GRAYLOG_STAGE_VERIFY_SSL=false

# Общие значения по умолчанию (переопределяются через GRAYLOG_<NAME>_...)
# false — не проверять TLS-сертификат (самоподписанный)
GRAYLOG_VERIFY_SSL=true
GRAYLOG_TIMEOUT_MS=30000
GRAYLOG_MAX_LIMIT=500
